# Copy this file to .env.local and fill in real values once the client's
# Cloudflare R2 and Neon accounts exist. .env.local is gitignored (see
# .gitignore) — never commit real credentials.

# --- Neon Postgres ---
DATABASE_URL="postgres://user:password@ep-example-12345.us-east-2.aws.neon.tech/psi_moc_portal?sslmode=require"

# --- Cloudflare R2 (S3-compatible object storage) ---
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="psi-moc-portal-files"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# --- Session / auth ---
SESSION_COOKIE_NAME="psi_session"
SESSION_SECRET="replace-with-a-long-random-string-min-32-bytes"
SESSION_TTL_DAYS="7"

# --- One-time migration scripts only (scripts/migrate.ts, scripts/seed-curated-documents.ts) ---
# Never read by the deployed Next.js app itself — only by `pnpm migrate:files` /
# `pnpm migrate:dry-run` / `pnpm seed:documents`, run locally.
MIGRATION_SOURCE_ROOT="C:\Users\thori\Downloads\kerja\pertamina dashboard\02. Process Safety"
