# Copy this file to .env.local and fill in real values once the client's
# Cloudflare R2 and Neon accounts exist. .env.local is gitignored (see
# .gitignore) — never commit real credentials.

# --- Neon Postgres ---
DATABASE_URL="postgres://user:password@ep-example-12345.us-east-2.aws.neon.tech/psi_moc_portal?sslmode=require"

# --- Cloudflare R2 (S3-compatible object storage) ---
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="psi-moc-portal-files"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# --- Session / auth ---
SESSION_COOKIE_NAME="psi_session"
SESSION_SECRET="replace-with-a-long-random-string-min-32-bytes"
SESSION_TTL_DAYS="7"

# --- Resend (transactional email — password reset) ---
# Sandbox sender "onboarding@resend.dev" works with just an API key, but can only
# deliver to the email address the Resend account was signed up with — verify a
# domain in the Resend dashboard and set RESEND_FROM_EMAIL to go live for everyone.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Portal PSI & MOC <onboarding@resend.dev>"

# --- Google OAuth ("Masuk dengan Google") ---
# From a Google Cloud Console OAuth 2.0 Client (Web application type). The redirect
# URI is derived from the request's own origin at runtime (see
# src/app/api/auth/google/route.ts), but it must still be registered verbatim as an
# Authorized redirect URI for EACH origin this app runs on:
#   http://localhost:3000/api/auth/google/callback
#   https://<production-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# --- One-time migration scripts only (scripts/migrate.ts, scripts/seed-curated-documents.ts) ---
# Never read by the deployed Next.js app itself — only by `pnpm migrate:files` /
# `pnpm migrate:dry-run` / `pnpm seed:documents`, run locally.
MIGRATION_SOURCE_ROOT="C:\Users\thori\Downloads\kerja\pertamina dashboard\02. Process Safety"

# --- Keamanan login (semua OPSIONAL; bila kosong fitur terkait tidak aktif) ---
# Kunci enkripsi rahasia MFA di database (AES-256-GCM). Atur SEKALI dan simpan; mengganti kunci membuat rahasia MFA lama
# tak terbaca (user harus mengaktifkan ulang MFA / admin mereset). Bila kosong dipakai SESSION_SECRET.
MFA_ENCRYPTION_KEY=""
# "true" = Admin Regional hanya boleh mengaktifkan akun yang emailnya sudah terverifikasi. Aktifkan SETELAH domain pengirim
# email diverifikasi di Resend (RESEND_FROM_EMAIL memakai domain sendiri); dengan alamat uji Resend, email hanya sampai ke pemilik akun Resend.
EMAIL_VERIFICATION_REQUIRED="false"
# Akun BARU lewat login Google hanya dibuat bila domain emailnya ada di daftar ini (pisah koma). Kosong = tidak dibatasi.
SIGNUP_ALLOWED_EMAIL_DOMAINS=""
